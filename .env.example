# Copy to .env and fill in.
# Shared secret required on /rates?token=...
RATES_TOKEN=change-me
# Shared cache store. Pick ONE:
#   • Share one Redis across machines (recommended): the Pi runs Redis (see
#     docker-compose.pi.yml) and exposes it via REDIS_BIND; every box points at it:
#       REDIS_URL=redis://<pi-ip>:6379            (use a Tailscale/LAN IP)
#     The Pi itself uses redis://redis:6379 (its in-compose service).
#   • Own local Redis: `docker compose --profile local-redis up -d` +
#       REDIS_URL=redis://redis:6379
#   • Hosted (Upstash/other): use its TCP TLS URL (ioredis), NOT the REST URL:
#       REDIS_URL=rediss://default:<TOKEN>@<endpoint>.upstash.io:6379
#   • Unset — in-memory + the rank-cache.json file, single instance.
REDIS_URL=
# On the Pi ONLY: which address the shared Redis is published on. Default
# 127.0.0.1 = Pi-only. Set to the Pi's Tailscale/LAN IP so other boxes can reach
# it (no password — never bind to a public IP).
REDIS_BIND=127.0.0.1
# The warmer "leader" is the only instance that scrapes (from its own IP — must be
# residential for SBI etc.). On a viewer-only box that shares the same Redis, set
# WARMER=off so it never scrapes; leave blank on the box that should scrape.
WARMER=
# --- Freshness / anti-bot cadence -------------------------------------------
# CACHE_TTL is the background warmer's FULL-CYCLE time: with 9 corridors it
# refreshes one every CACHE_TTL/9 s, so each corridor is at most ~CACHE_TTL old.
# Lower = fresher data, more upstream calls. 120 ≈ 2-min-fresh, comfortably safe.
# INVARIANT: keep GME_TTL and PROVIDER_TTL BELOW CACHE_TTL — the warmer respects
# the per-provider memo, so an equal/higher TTL makes it serve a stale memo hit
# instead of actually re-fetching. GME is the anti-bot bottleneck (429s after a
# burst); its 1.5s gap + backoff live in limiter.mjs — don't remove them.
# Self-hosted Redis has no per-command limits, so the fast cadence is fine.
# (If you ever move to a metered hosted Redis, raise CACHE_TTL to ~600 — the ~12s
# warmer at 120 runs ~1.2M commands/month.) Keep GME_TTL and PROVIDER_TTL below
# CACHE_TTL.
CACHE_TTL=120
GME_TTL=100
PROVIDER_TTL=80
# Never serve a corridor older than this (SWR ceiling + carry-forward bound).
MAX_STALE=900
# Admin pipeline login. Generate with:
#   npx tsx scripts/hash-password.ts "your-strong-password"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN=
# Cloudflare NAMED tunnel token from Zero Trust -> Networks -> Tunnels -> (your tunnel).
# Leave blank to use the quick tunnel (--profile quick) instead.
CF_TUNNEL_TOKEN=
# Teams Incoming Webhook / Workflow URL for the sheet "Send to Teams" button.
# Teams channel -> ... -> Workflows/Connectors -> Incoming Webhook -> copy URL.
# Leave blank to hide the button.
TEAMS_WEBHOOK_URL=
