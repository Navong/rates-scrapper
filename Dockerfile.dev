FROM node:22-alpine

# Match the production runtime so provider requests and image rendering behave
# the same while Next.js runs with hot reload.
RUN apk add --no-cache tzdata ttf-dejavu fontconfig
ENV TZ=Asia/Seoul
ENV NODE_ENV=development

WORKDIR /app

# Dependencies stay inside the Linux image. Source code is bind-mounted by
# docker-compose.dev.yml, so normal edits never require another image build.
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY . .

ENV PORT=8787
EXPOSE 8787

CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
